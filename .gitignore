# Build outputs
/bin/
/dist/

# Stray `go build ./cmd/<x>` outputs dropped in the repo root (no -o).
# One entry per cmd/ package, with and without the Windows .exe suffix.
# This list used to name three of the four and catalog-tool was the one it
# missed, so a 15 MB ELF landed in the repository root and shipped
# (#1099). scripts/ci/tracked-binary-guard.sh now derives the expected set
# from cmd/*/ and fails when this list drifts from it again.
/catalog-tool
/catalog-tool.exe
/waired
/waired.exe
/waired-agent
/waired-agent.exe
/waired-tray
/waired-tray.exe

# docs-site build outputs (docs-site/.gitignore covers these too; kept
# here so a root-level `git status` stays clean even if that file moves)
/docs-site/node_modules/
/docs-site/dist/
/docs-site/.astro/
/docs-site/.firebase/

# Local Go workspace (developers may point proto at a monorepo checkout;
# never commit it)
go.work
go.work.sum

# Editor / OS noise
.DS_Store
*.swp

# Local worktrees (.claude/worktrees/ current, .worktrees/ legacy)
/.claude/worktrees/
/.worktrees/

# Byte-cache from running the scripts/dev/*.py helpers
__pycache__/
