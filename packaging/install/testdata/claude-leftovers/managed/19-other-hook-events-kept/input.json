{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "audit"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "waired claude _fallback-hook",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ]
  }
}
