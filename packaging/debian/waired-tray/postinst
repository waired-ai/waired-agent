#!/bin/sh
set -e

case "$1" in
  configure)
    if [ -z "$2" ]; then
      cat <<'EOF'

The Waired app (waired-tray) is installed. To start using it:

  - Log out and back in to your desktop session, or
  - Run `waired-tray &` from a terminal in your desktop session.

Then open the Waired app's menu and pick "Sign in..." to sign this
computer in.

EOF
    fi
    ;;

  abort-upgrade|abort-remove|abort-deconfigure)
    ;;

  *)
    echo "postinst called with unknown argument \`$1'" >&2
    exit 1
    ;;
esac

#DEBHELPER#

exit 0
