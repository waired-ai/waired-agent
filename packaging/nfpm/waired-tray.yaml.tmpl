name: waired-tray
arch: ${ARCH}
version: ${PKG_VERSION}
version_schema: none
section: net
priority: optional
maintainer: "Waired Maintainers <maintainers@waired.dev>"
description: |
  System tray icon for Waired. Talks to the local waired-agent
  Management API on 127.0.0.1:9476 and brokers the privileged
  enrollment / logout commands through pkexec / polkit.
vendor: Waired
homepage: https://github.com/waired-ai/waired-agent
license: Apache-2.0

depends:
  - waired (>= ${PKG_VERSION})
  # pkexec is the package that ships /usr/bin/pkexec on Debian bookworm+
  # / Ubuntu 24.04+. The old `policykit-1` is a transitional package
  # there and has been *removed* in Ubuntu 26.04 / Debian trixie, so a
  # bare `policykit-1` dependency makes `apt install waired-tray`
  # unsatisfiable on those releases. The `| policykit-1` alternative
  # keeps older releases (Ubuntu jammy and earlier, Debian bullseye)
  # working, where pkexec is still provided by policykit-1 itself.
  - pkexec | policykit-1

# GNOME has no built-in SNI host, so on GNOME the tray icon only renders with an
# AppIndicator host extension (waired#493). This is Suggests, NOT Recommends,
# and promoting it would be a bug, not an improvement:
#
# On Ubuntu 26.04 `gnome-shell-extension-appindicator` is no longer a real
# package — it is a VIRTUAL one whose only provider is
# gnome-shell-ubuntu-extensions, which itself `Depends: gnome-shell (>= 49~)`.
# apt auto-installs Recommends, so a Recommends here would install GNOME Shell,
# gjs and the whole gir stack onto every server that runs `apt install
# waired-tray`. Depends would be worse. Nor is there a middle ground: apt has no
# conditional-dependency form, and `A | B` means "satisfied if either is
# installed, else install the first" — not "only if a desktop is already here".
#
# So the decision has to be made at runtime, where the host can be looked at,
# and it is, in three places that share one rule — never install unless
# gnome-shell is already present (#295):
#
#   - install.sh adds the package to its own apt transaction on a GNOME host,
#     and pre-enables it for the invoking user (linux_wants_tray_host_extension);
#   - waired-tray re-checks the session bus at every login and enables an
#     installed-but-disabled extension itself, needing no privilege;
#   - `waired doctor --fix` does both for anything the other two missed.
#
# The Suggests stays to advertise the relationship (apt show / GUI front-ends)
# for someone installing by hand.
suggests:
  - gnome-shell-extension-appindicator

contents:
  - src: bin/linux_${ARCH}/waired-tray
    dst: /usr/bin/waired-tray
    file_info:
      mode: 0755

  - src: build/autostart/waired-tray.desktop
    dst: /etc/xdg/autostart/waired-tray.desktop
    file_info:
      mode: 0644

  # App-grid launcher (issue #492): the autostart entry above is not
  # shown in the GNOME application list, so without this the tray is
  # undiscoverable / unlaunchable from the GUI. Exec is PATH-relative
  # (waired-tray) so it resolves against /usr/bin here and
  # /usr/local/bin for the manual installer.
  - src: build/applications/waired-tray.desktop
    dst: /usr/share/applications/waired-tray.desktop
    file_info:
      mode: 0644

  - src: build/polkit/com.waired.policy
    dst: /usr/share/polkit-1/actions/com.waired.policy
    file_info:
      mode: 0644

  # License notices (#666): see waired.yaml.tmpl — staged into dist/ by
  # scripts/ci/gen-third-party-licenses.sh.
  - src: dist/LICENSE
    dst: /usr/share/doc/waired-tray/LICENSE
    file_info:
      mode: 0644

  - src: dist/THIRD_PARTY_LICENSES
    dst: /usr/share/doc/waired-tray/THIRD_PARTY_LICENSES
    file_info:
      mode: 0644

scripts:
  postinstall: packaging/debian/waired-tray/postinst
  postremove:  packaging/debian/waired-tray/postrm

deb:
  fields:
    Bugs: https://github.com/waired-ai/waired-agent/issues
