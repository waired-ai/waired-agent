// waired OpenCode integration — registers the "waired" provider via the
// OpenCode plugin `config` hook, so no opencode.json edit is needed.
//
// GENERATED by waired (`waired link opencode`). Do not edit: it is
// rewritten on every link and deleted on unlink.
//
// The rows are read from the gateway at every OpenCode start rather than
// baked in here. They say which COMPUTER answers — this one, another of
// yours, a named one, someone else's — and which computers are on the mesh
// changes between links, so a list written once goes stale (waired-agent#1306).
// The `config` hook is async and OpenCode awaits it, which is what makes the
// read possible; measured on OpenCode 1.18.30 (2026-09-12).
//
// waired/default is the fallback and the whole list before this change: it
// needs no facts about the mesh — the router picks a computer and that
// computer's own model answers (#632) — so it is the honest thing to offer
// when the gateway cannot be reached.

// Written twice from one template value, so the two can never disagree. The
// second spelling is what `waired doctor`, the Waired app and the installation
// audit read to tell a current plugin from one pointing at an old port
// (internal/integration/detect/opencode.go matches the provider option by
// name), and a plugin from before waired-agent#1306 has only that one. Do not
// write that option name into a comment above this line: the detector takes
// the FIRST match in the file, and a comment carrying an example URL is the
// one it would read.
const BASE_URL = {{ .BaseURLLiteral }};
const FALLBACK = { default: { id: "waired/default", name: "Waired Default" } };
const DISCOVERY_TIMEOUT_MS = 2000;

// The picker shows `waired/<key>`, and the model that leaves on the wire is
// `id`. Keeping the key as the id minus its "waired/" head makes the two
// spellings the same string, so what a user reads in the picker is what
// `waired logs` shows for the turn.
function modelKey(id) {
  return id.startsWith("waired/") ? id.slice("waired/".length) : id;
}

async function discover() {
  const res = await fetch(BASE_URL + "/models", {
    signal: AbortSignal.timeout(DISCOVERY_TIMEOUT_MS),
  });
  if (!res.ok) return null;
  const body = await res.json();
  const models = {};
  for (const m of body.data || []) {
    // Only the rows that name a computer. The rest of that listing is this
    // host's model catalog, which is a different question.
    if (!m || !m.waired_route || !m.id) continue;
    const key = modelKey(m.id);
    if (!key) continue;
    models[key] = {
      id: m.id,
      name: m.display_name || m.id,
      ...(m.max_input_tokens > 0 ? { limit: { context: m.max_input_tokens } } : {}),
    };
  }
  return Object.keys(models).length ? models : null;
}

export const WairedPlugin = async () => ({
  config: async (config) => {
    let models = FALLBACK;
    try {
      models = (await discover()) || FALLBACK;
    } catch {
      // The daemon is not running, or not running yet — `waired init`
      // configures coding tools before anything is serving. Offering the one
      // row that always routes beats offering none.
      models = FALLBACK;
    }
    config.provider = config.provider || {};
    config.provider.waired = {
      npm: "@ai-sdk/openai-compatible",
      name: "Waired",
      options: { baseURL: {{ .BaseURLLiteral }} },
      models,
    };
  },
});
