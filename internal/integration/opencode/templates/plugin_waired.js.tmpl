// waired OpenCode integration — registers the "waired" provider via the
// OpenCode plugin `config` hook, so no opencode.json edit is needed.
//
// GENERATED by waired (`waired link opencode`). Do not edit: it is
// rewritten on every link and deleted on unlink.
//
// The rows are read from the gateway at every OpenCode start rather than
// baked in here. They say which COMPUTER answers — this one, another of
// yours, a named one, someone else's — and which computers are on the mesh
// changes between links, so a list written once goes stale (waired-agent#1306).
// The `config` hook is async and OpenCode awaits it, which is what makes the
// read possible; measured on OpenCode 1.18.30 (2026-09-12).
//
// waired/default is the fallback and the whole list before this change: it
// needs no facts about the mesh — the router picks a computer and that
// computer's own model answers (#632) — so it is the honest thing to offer
// when the gateway cannot be reached.

// Written twice from one template value, so the two can never disagree. The
// second spelling is what `waired doctor`, the Waired app and the installation
// audit read to tell a current plugin from one pointing at an old port
// (internal/integration/detect/opencode.go matches the provider option by
// name), and a plugin from before waired-agent#1306 has only that one. Do not
// write that option name into a comment above this line: the detector takes
// the FIRST match in the file, and a comment carrying an example URL is the
// one it would read.
const BASE_URL = {{ .BaseURLLiteral }};
const DISCOVERY_TIMEOUT_MS = 2000;
// Which revision of this file's own logic wrote it. `waired doctor` and the
// refresh after `waired link` rewrite a plugin whose revision is older than
// the build's, so a change in what the plugin DOES reaches a user who never
// links again. 2: a row's listed window below CONTEXT_WINDOW is taken
// (waired-ai/waired#1481).
const PLUGIN_REV = {{ .PluginRevLiteral }};

// The window OpenCode sizes a conversation to, and compacts against. A Waired
// row is one of two sessions, decided by its id: a "[1m]" row is
// CONTEXT_WINDOW_1M, and every other row is CONTEXT_WINDOW, whichever
// computer answers it. The gateway makes the computer that answers hold at
// least that many tokens and holds the turn to it (waired-agent#1396).
//
// One exception: a row naming a computer that serves a custom model whose
// own window is below CONTEXT_WINDOW lists that window, and the gateway holds
// the turn to it — so OpenCode is told the smaller number and compacts before
// the gateway has to refuse a turn (waired-ai/waired#1481). A listed window at
// or above CONTEXT_WINDOW changes nothing.
//
// OpenCode's config schema requires `output` beside `context`, and warns on
// every start without it (waired-agent#1367). Nothing on this host states an
// output figure, so 0: it is the value OpenCode itself stores when the key is
// absent, and OpenCode reads it as "not stated" — its own default cap applies
// either way. Measured on OpenCode 1.18.30: the same resolved model and the
// same max_tokens with and without it.
//
// A row with a window that small states an output limit too. Before it
// compacts, OpenCode holds back an output reserve from the window: the model's
// output limit, or 32,000 tokens when none is stated (usable = context −
// maxOutputTokens, packages/opencode/src/session/overflow.ts at v1.18.30).
// Against a small window that reserve is most of it — at 40,960 tokens it left
// less than one request of OpenCode's own, and OpenCode compacted and
// re-sent without end (measured with a stub for waired-ai/waired#1482). So a
// small row states SMALL_ROW_OUTPUT, or a quarter of its window when that is
// less, which is also the most OpenCode then asks the model to write.
const CONTEXT_WINDOW = {{ .ContextWindowLiteral }};
const CONTEXT_WINDOW_1M = {{ .ContextWindow1MLiteral }};
const SMALL_ROW_OUTPUT = 8192;
function limitFor(key, listed) {
  let context = key.toLowerCase().includes("[1m]") ? CONTEXT_WINDOW_1M : CONTEXT_WINDOW;
  let output = 0;
  if (typeof listed === "number" && listed > 0 && listed < CONTEXT_WINDOW) {
    context = listed;
    output = Math.min(SMALL_ROW_OUTPUT, Math.floor(listed / 4));
  }
  return { context, output };
}

const FALLBACK = { default: { id: "waired", name: "Waired", limit: limitFor("default") } };

// The picker shows `waired/<key>`, and the model that leaves on the wire is
// `id`. The key is the listed id minus its "waired/" head, so what a user
// reads in the picker is what `waired logs` shows for the turn — with one
// exception. The row where Waired picks any of your computers is listed as
// waired/default and waired/default[1m], the refs every config written so far
// holds, but it is SENT as "waired" and "waired[1m]", the ids Claude Code
// sends. Those carry the row's window floor; waired/default itself is the
// daemon's no-floor alias that chat apps send (waired-agent#1395).
function rowIds(id) {
  const key = id.startsWith("waired/") ? id.slice("waired/".length) : id;
  if (key === "default" || key === "waired") return { key: "default", wire: "waired" };
  if (key === "default[1m]" || key === "waired[1m]") return { key: "default[1m]", wire: "waired[1m]" };
  return { key, wire: id };
}

async function discover() {
  const res = await fetch(BASE_URL + "/models", {
    signal: AbortSignal.timeout(DISCOVERY_TIMEOUT_MS),
  });
  if (!res.ok) return null;
  const body = await res.json();
  const models = {};
  for (const m of body.data || []) {
    // Only the rows that name a computer. The rest of that listing is this
    // host's model catalog, which is a different question.
    if (!m || !m.waired_route || !m.id) continue;
    const { key, wire } = rowIds(m.id);
    if (!key) continue;
    // The window comes from the key, and from the listing only when the
    // listing names a smaller one (limitFor).
    models[key] = {
      id: wire,
      name: m.display_name || m.id,
      limit: limitFor(key, m.max_input_tokens),
    };
  }
  return Object.keys(models).length ? models : null;
}

export const WairedPlugin = async () => ({
  config: async (config) => {
    let models = FALLBACK;
    try {
      models = (await discover()) || FALLBACK;
    } catch {
      // The daemon is not running, or not running yet — `waired init`
      // configures coding tools before anything is serving. Offering the one
      // row that always routes beats offering none.
      models = FALLBACK;
    }
    config.provider = config.provider || {};
    config.provider.waired = {
      npm: "@ai-sdk/openai-compatible",
      name: "Waired",
      options: { baseURL: {{ .BaseURLLiteral }} },
      models,
    };
  },
});
