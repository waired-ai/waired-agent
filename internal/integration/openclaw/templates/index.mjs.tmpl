// waired OpenClaw integration — registers an independent "waired" provider
// via an OpenClaw plugin, so no `models.providers` edit to openclaw.json is
// needed.
//
// GENERATED by waired (`waired link openclaw`). Do not edit: it is rewritten
// on every link and deleted on unlink. The provider points at waired's
// no-token loopback gateway. `resolveDynamicModel` maps a reference like
// `waired/peer` to a runtime model whose `id` is the wire string the gateway
// expects. No manifest owns those names — the gateway resolves each to a
// computer at request time (waired-agent#1306) — so a config written once
// survives a model switch. `resolveSyntheticAuth` supplies a non-secret
// local marker so no API key or environment variable is ever required — the
// same pattern OpenClaw's own local Ollama / LM Studio providers use.
//
// MODELS is written at link time from the gateway's own listing, because
// OpenClaw's picker shows what `agents.defaults.models` in openclaw.json
// allowlists and that file is written by the same step. Unlike OpenCode,
// whose plugin reads the listing itself at every start, an OpenClaw row that
// names a computer is only as fresh as the last `waired link`, `waired doctor
// --fix`, or Reconfigure in the Waired app. Measured on OpenClaw 2026.9.4
// (2026-09-12): a provider plugin's own catalog hooks do not reach the picker,
// and a `waired/*` wildcard in the allowlist is taken literally.
const BASE_URL = {{ .BaseURLLiteral }};
// Which revision of this file's own logic wrote it. `waired doctor` and the
// refresh after `waired link all` rewrite a plugin whose revision is older
// than the build's, so a change in what the plugin SENDS reaches a user who
// never links again (waired-agent#1395).
const PLUGIN_REV = {{ .PluginRevLiteral }};
const SYNTHETIC_KEY = "waired-local";
const COST = { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 };
// The window the gateway stated for waired/default when the plugin was written
// (max_input_tokens). It is 0 when the gateway could not be asked — during
// `waired init`, before anything is serving — and then the field is left out
// so OpenClaw uses its own default. A wrong number is worse than none: a value
// below what the answering computer holds makes OpenClaw compact on the first
// turn (#1001), one above it lets a prompt through that the computer refuses.
// Only waired/default falls back to it, for a plugin written before the rows.
const CONTEXT_WINDOW = {{ .ContextWindowLiteral }};
// One entry per row the gateway offered: {key, name, contextWindow}. Each row
// carries the window the gateway states for it — the floor routing holds a
// row to where Waired picks the computer, and the computer's own window where
// the row names one. A computer that states none carries none, rather than
// borrowing another row's number (waired-agent#1395).
const MODELS = {{ .ModelsLiteral }};

function rowFor(key) {
  for (const m of MODELS) {
    if (m.key === key) return m;
  }
  return null;
}

// wireId is the model string the gateway receives for a picker key. The key
// is the listed id minus "waired/", except for the row where Waired picks any
// of your computers: it is listed as waired/default and waired/default[1m],
// which is what every config written so far holds, and SENT as "waired" and
// "waired[1m]", the ids Claude Code sends. Those carry the row's window floor;
// waired/default itself is the daemon's no-floor alias that chat apps send
// (waired-agent#1395).
function wireId(key) {
  if (key === "default") return "waired";
  if (key === "default[1m]") return "waired[1m]";
  return "waired/" + key;
}

function wairedModel(key) {
  const row = rowFor(key);
  const model = {
    id: wireId(key),
    name: row && row.name ? row.name : "Waired " + key.charAt(0).toUpperCase() + key.slice(1),
    provider: "waired",
    api: "openai-completions",
    baseUrl: BASE_URL,
    reasoning: false,
    input: ["text"],
    cost: COST,
    maxTokens: 8192,
    compat: { supportsTools: true, supportsUsageInStreaming: true },
  };
  const window = row ? row.contextWindow || 0 : key === "default" ? CONTEXT_WINDOW : 0;
  if (window > 0) {
    model.contextWindow = window;
  }
  return model;
}

export default {
  id: "waired",
  name: "Waired",
  description: "Waired local inference provider",
  register(api) {
    api.registerProvider({
      id: "waired",
      label: "Waired",
      // Non-secret synthetic credential: the gateway is no-token, but
      // OpenClaw requires *some* resolvable key before it will dispatch.
      resolveSyntheticAuth: () => ({
        apiKey: SYNTHETIC_KEY,
        source: "waired plugin (synthetic local key)",
        mode: "api-key",
      }),
      shouldDeferSyntheticProfileAuth: ({ resolvedApiKey }) =>
        (resolvedApiKey || "").trim() === SYNTHETIC_KEY,
      // Resolve a waired/* reference without a models.providers config entry.
      // The returned model's `id` becomes the on-wire model string.
      //
      // Every non-empty key resolves, not only the ones in MODELS: which
      // computers are on the mesh changes between links, and declining a name
      // this plugin has not heard of would answer for the gateway. The
      // gateway is the authority, and it says which computer is missing.
      resolveDynamicModel: (ctx) => {
        const key = String((ctx && ctx.modelId) || "").replace(/^waired\//, "");
        return key ? wairedModel(key) : null;
      },
    });
  },
};
