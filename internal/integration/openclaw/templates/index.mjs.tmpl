// waired OpenClaw integration — registers an independent "waired" provider
// via an OpenClaw plugin, so no `models.providers` edit to openclaw.json is
// needed.
//
// GENERATED by waired (`waired link openclaw`). Do not edit: it is rewritten
// on every link and deleted on unlink. The provider points at waired's
// no-token loopback data-plane gateway. `resolveDynamicModel` maps the
// reference `waired/default` to a runtime model whose `id` is the wire
// string the gateway expects. No manifest owns that name — the router
// resolves it at request time to this host's coding default (#632), so a
// config written once survives a model switch. waired/coding and
// waired/small were retired in #521; a model that is not the default is
// named directly. `resolveSyntheticAuth` supplies a non-secret local
// marker so no API key or environment variable is ever required — the
// same pattern OpenClaw's own local Ollama / LM Studio providers use.
const BASE_URL = {{ .BaseURLLiteral }};
const SYNTHETIC_KEY = "waired-local";
const MODEL_KEYS = ["default"];
const COST = { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 };
// The input window this host reported it can actually serve when the plugin
// was written (waired's gateway, max_input_tokens). It is 0 when the gateway
// could not be asked — during `waired init`, before anything is serving —
// and then the field is left out entirely so OpenClaw uses its own default.
// A wrong number is worse than none: a value below what the host serves makes
// OpenClaw compact its context on the first turn (#1001).
const CONTEXT_WINDOW = {{ .ContextWindowLiteral }};

function wairedModel(key) {
  const model = {
    id: "waired/" + key,
    name: "Waired " + key.charAt(0).toUpperCase() + key.slice(1),
    provider: "waired",
    api: "openai-completions",
    baseUrl: BASE_URL,
    reasoning: false,
    input: ["text"],
    cost: COST,
    maxTokens: 8192,
    compat: { supportsTools: true, supportsUsageInStreaming: true },
  };
  if (CONTEXT_WINDOW > 0) {
    model.contextWindow = CONTEXT_WINDOW;
  }
  return model;
}

export default {
  id: "waired",
  name: "Waired",
  description: "Waired local inference provider",
  register(api) {
    api.registerProvider({
      id: "waired",
      label: "Waired",
      // Non-secret synthetic credential: the data-plane gateway is no-token,
      // but OpenClaw requires *some* resolvable key before it will dispatch.
      resolveSyntheticAuth: () => ({
        apiKey: SYNTHETIC_KEY,
        source: "waired plugin (synthetic local key)",
        mode: "api-key",
      }),
      shouldDeferSyntheticProfileAuth: ({ resolvedApiKey }) =>
        (resolvedApiKey || "").trim() === SYNTHETIC_KEY,
      // Resolve waired/default without a models.providers config entry.
      // The returned model's `id` becomes the on-wire model string.
      resolveDynamicModel: (ctx) => {
        const key = String((ctx && ctx.modelId) || "").replace(/^waired\//, "");
        return MODEL_KEYS.includes(key) ? wairedModel(key) : null;
      },
    });
  },
};
