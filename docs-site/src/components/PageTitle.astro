---
/**
 * PageTitle override — Starlight's h1, plus the per-page header block
 * ("who this is for / what you need / how long") driven by the `meta`
 * frontmatter field. Every comparable docs site puts this above the fold;
 * ours used to have it on Quickstart only, written by hand.
 *
 * This component also used to render a translation-freshness notice on
 * `ja/` pages, from the `sourceHash` frontmatter field. Both are gone
 * (waired-agent#1215). The notice was described as a second line of
 * defence behind `scripts/i18n-sync.mjs`, but deploy-docs.yml runs that
 * check in the same job and BEFORE the build, so a page it would have
 * fired on never reaches the site — the notice could only ever appear in
 * a local `npm run dev`, and never did appear on docs.waired.ai.
 */
const PAGE_TITLE_ID = '_top';
// Starlight does not export its `constants` module through package
// exports, so the id is mirrored here. It is the anchor the "Back to top"
// link and the table of contents both target — changing it silently breaks
// both, which is why it is pinned with a name rather than inlined below.

const route = Astro.locals.starlightRoute;
const entry = route.entry;
const data = entry.data as {
	title: string;
	meta?: { audience?: string; needs?: string; time?: string };
};

const meta = data.meta;
const metaRows = meta
	? ([
			['Who', meta.audience],
			['You need', meta.needs],
			['Time', meta.time],
		].filter(([, v]) => !!v) as [string, string][])
	: [];
const isJa = route.locale === 'ja';
const label = isJa
	? { Who: '対象', 'You need': '必要なもの', Time: '所要時間' }
	: { Who: 'Who this is for', 'You need': 'You need', Time: 'Time' };
---

<h1 id={PAGE_TITLE_ID}>{data.title}</h1>

{
	metaRows.length > 0 && (
		<dl class="wd-pagemeta">
			{metaRows.map(([k, v]) => (
				<div class="wd-pagemeta-row">
					<dt>{label[k as keyof typeof label]}</dt>
					<dd>{v}</dd>
				</div>
			))}
		</dl>
	)
}

<style>
	@layer starlight.core {
		h1 {
			margin-top: 1rem;
			font-size: var(--sl-text-h1);
			line-height: var(--sl-line-height-headings);
			font-weight: 600;
			color: var(--sl-color-white);
		}
	}

	/* The header block is deliberately quiet: it is scaffolding the reader
	   checks once, not content. Label column stays narrow so the values
	   line up into a scannable column. */
	.wd-pagemeta {
		margin: 1.25rem 0 0;
		display: grid;
		gap: 0.35rem;
		border-inline-start: 2px solid var(--sl-color-hairline);
		padding-inline-start: 1rem;
	}
	.wd-pagemeta-row {
		display: grid;
		grid-template-columns: minmax(6.5rem, max-content) 1fr;
		gap: 0.25rem 1rem;
	}
	.wd-pagemeta dt {
		font-size: var(--sl-text-xs);
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--sl-color-gray-3);
		padding-top: 0.15em;
	}
	.wd-pagemeta dd {
		margin: 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
		line-height: 1.55;
	}
	@media (max-width: 30rem) {
		.wd-pagemeta-row {
			grid-template-columns: 1fr;
			gap: 0;
		}
	}
</style>
